// Export surface for the mvt and tess benches and golden tests; names come from `#export_name`.

import {
  "t-ujiie-g/clipper",
  "t-ujiie-g/mbtmap_engine/cluster_props",
  "t-ujiie-g/mbtmap_engine/core",
  "t-ujiie-g/draco",
  "t-ujiie-g/lepcc",
  "t-ujiie-g/mbtmap_engine/formats",
  "t-ujiie-g/mbtmap_engine/geom",
  "t-ujiie-g/mbtmap_engine/globe",
  "t-ujiie-g/meshopt",
  "t-ujiie-g/mvt",
  "t-ujiie-g/proj",
  "t-ujiie-g/mbtmap_engine/route",
  "t-ujiie-g/mbtmap_engine/style",
  "t-ujiie-g/mbtmap_engine/tess",
  "t-ujiie-g/mbtmap_engine/tiler",
  "moonbitlang/core/double",
}

supported_targets = "+js+wasm+wasm-gc"

pkgtype(kind: "foreign_library")

options(
  targets: {
    "golden.mbt": [ "js" ],
    "js_input.mbt": [ "js" ],
    "linear_memory.mbt": [ "wasm", "wasm-gc" ],
    "host_math.mbt": [ "wasm", "wasm-gc" ],
    "meshopt_mem.mbt": [ "wasm", "wasm-gc" ],
  },
  link: {
    "wasm": { "export-memory-name": "memory" },
    "wasm-gc": { "export-memory-name": "memory" },
    "js": { "format": "esm" },
  },
)
