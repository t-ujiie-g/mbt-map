name = "t-ujiie-g/mbtmap_engine"

version = "0.0.1"

readme = "README.md"

repository = "https://github.com/t-ujiie-g/mbt-map"

license = "Apache-2.0"

keywords = [ "map", "gis", "webgis", "vector-tile", "webgl2", "3d-tiles" ]

description = "A lightweight WebGIS library for the web: maps, analysis, data formats, GIS services and 3D"

import {
  "t-ujiie-g/clipper@0.1.0",
  "t-ujiie-g/draco@0.1.0",
  "t-ujiie-g/geodesic@0.1.0",
  "t-ujiie-g/lepcc@0.1.0",
  "t-ujiie-g/meshopt@0.1.0",
  "t-ujiie-g/mvt@0.1.0",
  "t-ujiie-g/pbf@0.1.0",
  "t-ujiie-g/proj@0.1.0",
  "t-ujiie-g/robust@0.1.0",
  "t-ujiie-g/tiff@0.1.0",
  "t-ujiie-g/trig@0.1.0",
}
