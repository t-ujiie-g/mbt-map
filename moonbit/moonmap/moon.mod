// The MoonBit API of moon-map: a typed binding to the npm package's implementation (js target).

name = "t-ujiie-g/moonmap"

version = "0.0.1"

readme = "README.md"

repository = "https://github.com/t-ujiie-g/moon-map"

license = "Apache-2.0"

keywords = [ "map", "gis", "webgis", "maplibre", "rabbita" ]

description = "Maps and WebGIS for MoonBit web apps: a typed API over the moon-map npm package"

supported_targets = "js"
