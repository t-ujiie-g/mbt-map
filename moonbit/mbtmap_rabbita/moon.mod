// mbt-map for rabbita apps: the <mbt-map> element as a view, its events as messages (js target).

name = "t-ujiie-g/mbtmap_rabbita"

version = "0.2.0"

readme = "README.md"

repository = "https://github.com/t-ujiie-g/mbt-map"

license = "Apache-2.0"

keywords = [ "map", "gis", "webgis", "rabbita" ]

description = "Maps in rabbita apps: the mbt-map element as a view, its events as messages"

import {
  "moonbit-community/rabbita@0.16.7",
  "t-ujiie-g/mbtmap@0.2.0",
}

supported_targets = "js"

preferred_target = "js"
