// The MoonBit API of mbt-map: a typed binding to the npm package's implementation (js target).

name = "t-ujiie-g/mbtmap"

version = "0.2.0"

readme = "README.md"

repository = "https://github.com/t-ujiie-g/mbt-map"

license = "Apache-2.0"

keywords = [ "map", "gis", "webgis", "maplibre", "rabbita" ]

description = "Maps and WebGIS for MoonBit web apps: a typed API over the mbt-map npm package"

supported_targets = "js"

preferred_target = "js"
