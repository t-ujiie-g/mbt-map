// Expected hashes printed by bench/clipper/libcxx-sort-cases.cpp (libc++ 21).

///|
test "libcxx_sort leaves equal keys in std::sort's order, short of its depth limit" {
  let expected : Array[UInt32] = [
    0U, 0U, 0U, 0U, 0U, 0U, 0U, 0U, 0U, 0U, 0U, 0U, 0U, 0U, 1U, 1U, 31U, 1U, 1U,
    1U, 1U, 63U, 33U, 1923U, 33U, 1023U, 33U, 63U, 29856U, 31806U, 60636U, 1026U,
    62466U, 1026U, 1056U, 3753700U, 1848100U, 2890690U, 31810U, 2889760U, 31810U,
    33700U, 143178495U, 1971045U, 119225505U, 986115U, 119166015U, 986115U, 1074495U,
    1895094981U, 61908711U, 2838009981U, 30569571U, 316266275U, 30569571U, 34233861U,
    1975833672U, 173362176U, 2821476528U, 947656708U, 3874216414U, 947656708U, 1089849148U,
    1736787384U, 2679386758U, 3308866132U, 3974904838U, 2253027612U, 3974904838U,
    1637629528U, 4793939U, 347306873U, 809413949U, 3645875563U, 2698468937U, 3645875563U,
    999251485U, 834454816U, 950557854U, 451249266U, 1352992780U, 204122740U, 1352992780U,
    3636489580U, 889207692U, 1697112008U, 89837156U, 3288070540U, 2947833130U, 3288070540U,
    1001411706U, 2628415319U, 1111065243U, 52592671U, 2775178735U, 1682012817U, 2775178735U,
    2294817599U, 1260092620U, 1099277502U, 2950124894U, 1995038770U, 243669390U,
    131194896U, 596384654U, 1268349308U, 2258936382U, 71707456U, 1716659758U, 563386000U,
    4067041808U, 3189875326U, 2875875832U, 601911670U, 1535534058U, 3834105888U,
    277298370U, 2158477344U, 733498734U, 547950906U, 3098301588U, 4117244626U, 1496882610U,
    913292016U, 58926130U, 3065173752U, 235539060U, 4022352814U, 1995978016U, 2050692096U,
    2787413854U, 2237628480U, 2271667056U, 2806130832U, 2747772782U, 3808315352U,
    3441912960U, 3873758374U, 2792261696U, 768464268U, 3986262688U, 1801151130U,
    205276780U, 1721436708U, 317335866U, 2999917156U, 1563361146U, 774708280U, 3255300568U,
    557314664U, 1164619356U, 687375076U, 1166786938U, 3735350758U, 2552707464U, 748411264U,
    1633777270U, 1086475828U, 2139602636U, 1374890996U, 1625958022U, 4171694018U,
    1280452378U, 4024974308U, 2161352836U, 657935578U, 311378884U, 3780877996U,
  ]
  let sizes : Array[UInt32] = [
    0, 1, 2, 3, 4, 5, 6, 7, 8, 12, 23, 24, 25, 31, 32, 33, 64, 100, 128, 129, 200,
    500, 1000, 5000,
  ]
  let mut seed = 12345U
  let got = []
  for n in sizes {
    for pattern in 0..<7 {
      let items : Array[(UInt32, UInt32)] = []
      for i in 0U..<n {
        seed = seed * 1103515245U + 12345U
        let r = seed >> 8
        let key = match pattern {
          0 => r % 4U
          1 => r % (n / 4U + 1U)
          2 => r
          3 => i / 3U
          4 => (n - i) / 3U
          5 => 7U
          _ => (if i < n / 2U { i } else { n - i }) / 2U
        }
        items.push((key, i))
      }
      libcxx_sort(items, (a, b) => a.0 < b.0)
      for i in 1..<items.length() {
        assert_true(items[i - 1].0 <= items[i].0)
      }
      let mut h = 0U
      for item in items {
        h = h * 31U + item.1
      }
      // Organ pipes this long pass libc++'s depth limit, where it heap-sorts
      // and the port sorts stably: only the keys' order holds there.
      if pattern == 6 && n >= 500U {
        assert_not_eq(h, expected[got.length()])
        got.push(expected[got.length()])
      } else {
        got.push(h)
      }
    }
  }
  assert_eq(got, expected)
}
