///|
/// The same rows with Snappy pages.
let parquet_snappy : Bytes = b"\x50\x41\x52\x31\x15\x06\x15\x22\x15\x26\x5c\x15\x06\x15\x02\x15\x06\x15\x00\x15\x04\x15\x00\x00\x00\x03\x05\x0f\x38\x01\x00\x00\x00\x61\x06\x00\x00\x00\xe6\x9d\xb1\xe4\xba\xac\x15\x06\x15\x18\x15\x1c\x5c\x15\x06\x15\x00\x15\x06\x15\x00\x15\x00\x15\x00\x00\x00\x0c\x2c\x01\x00\x00\x00\x02\x00\x00\x00\x03\x00\x00\x00\x15\x06\x15\x68\x15\x44\x5c\x15\x06\x15\x02\x15\x06\x15\x00\x15\x04\x15\x00\x00\x00\x03\x03\x32\x18\x15\x00\x00\x00\x01\x01\x00\x11\x01\x04\xf0\x3f\x0d\x0a\x00\x40\x3a\x19\x00\x24\x08\x40\x00\x00\x00\x00\x00\x00\x10\x40\x15\x04\x19\x4c\x48\x04\x72\x6f\x6f\x74\x15\x06\x00\x15\x0c\x25\x02\x18\x04\x6e\x61\x6d\x65\x25\x00\x00\x15\x02\x25\x00\x18\x01\x6e\x00\x15\x0c\x25\x02\x18\x08\x67\x65\x6f\x6d\x65\x74\x72\x79\x00\x16\x06\x19\x1c\x19\x3c\x26\x08\x1c\x15\x0c\x19\x15\x00\x19\x18\x04\x6e\x61\x6d\x65\x15\x02\x16\x06\x16\x4c\x16\x50\x26\x08\x00\x00\x26\x58\x1c\x15\x02\x19\x15\x00\x19\x18\x01\x6e\x15\x02\x16\x06\x16\x42\x16\x46\x26\x58\x00\x00\x26\x9e\x01\x1c\x15\x0c\x19\x15\x00\x19\x18\x08\x67\x65\x6f\x6d\x65\x74\x72\x79\x15\x02\x16\x06\x16\x92\x01\x16\x6e\x26\x9e\x01\x00\x00\x16\xa0\x02\x16\x06\x36\x84\x02\x00\x19\x1c\x18\x03\x67\x65\x6f\x18\x74\x7b\x22\x76\x65\x72\x73\x69\x6f\x6e\x22\x3a\x22\x31\x2e\x31\x2e\x30\x22\x2c\x22\x70\x72\x69\x6d\x61\x72\x79\x5f\x63\x6f\x6c\x75\x6d\x6e\x22\x3a\x22\x67\x65\x6f\x6d\x65\x74\x72\x79\x22\x2c\x22\x63\x6f\x6c\x75\x6d\x6e\x73\x22\x3a\x7b\x22\x67\x65\x6f\x6d\x65\x74\x72\x79\x22\x3a\x7b\x22\x65\x6e\x63\x6f\x64\x69\x6e\x67\x22\x3a\x22\x57\x4b\x42\x22\x2c\x22\x67\x65\x6f\x6d\x65\x74\x72\x79\x5f\x74\x79\x70\x65\x73\x22\x3a\x5b\x22\x50\x6f\x69\x6e\x74\x22\x5d\x7d\x7d\x7d\x00\x18\x09\x68\x79\x70\x61\x72\x71\x75\x65\x74\x19\x3c\x1c\x00\x00\x1c\x00\x00\x1c\x00\x00\x00\x2a\x01\x00\x00\x50\x41\x52\x31"

///|
test "read_parquet reads rows, nulls and the WKB column the geo metadata names" {
  for bytes in [parquet_plain, parquet_snappy] {
    let (t, info) = @formats.read_parquet(bytes[:])
    assert_eq(info.geometry, "geometry")
    assert_true(info.geo.contains("\"primary_column\":\"geometry\""))
    assert_eq(t.columns.map(c => c.name), ["name", "n"])
    assert_eq(t.column("name").unwrap().values, [
      Some(Str("a")),
      Some(Null),
      Some(Str("東京")),
    ])
    assert_eq(t.column("n").unwrap().values, [
      Some(Num(1.0)),
      Some(Num(2.0)),
      Some(Num(3.0)),
    ])
    assert_true(t.kinds is [Point, Point, NoGeometry])
    assert_eq(t.coords, [1.0, 2.0, 3.0, 4.0])
    assert_eq(@formats.parquet_packed_pages(bytes[:]), [])
  }
}

///|
test "read_parquet refuses what is no Parquet file, by where and why" {
  let message = (bytes : Bytes) => {
    try @formats.read_parquet(bytes[:]) catch {
      e => e.message()
    } noraise {
      _ => ""
    }
  }
  assert_eq(message(b""), "malformed Parquet at 0: not a Parquet file")
  assert_eq(
    message(b"PAR1\xff\xff\xff\x7fPAR1"),
    "malformed Parquet at 4: a footer past the start of the file",
  )
  assert_eq(
    message(b"PAR1\x00\x00\x00\x15\x01\x00\x00\x00PAR1"),
    "malformed Parquet at 7: a malformed footer",
  )
  // Cut anywhere, or with any byte changed, the file is refused or read.
  for cut in 0..<parquet_snappy.length() {
    ignore(message(parquet_snappy[:cut].to_owned()))
  }
  let bytes = parquet_snappy.to_array()
  for i in 0..<bytes.length() {
    let damaged = bytes.copy()
    damaged[i] = (damaged[i].to_int() ^ 0x55).to_byte()
    ignore(message(Bytes::from_array(damaged)))
  }
  let listed = try @formats.parquet_packed_pages(b"PAR1") catch {
    _ => [-1]
  } noraise {
    pages => pages
  }
  assert_eq(listed, [-1])
}

///|
/// The FileMetaData of `parquet_plain`, as a host hands it to `parquet_open`.
fn plain_metadata() -> BytesView {
  let n = parquet_plain.length()
  let size = parquet_plain[n - 8].to_int() |
    (parquet_plain[n - 7].to_int() << 8)
  parquet_plain[n - 8 - size:n - 8]
}

///|
test "parquet_open, plan and read take a file in parts: only the ranges planned" {
  let file = @formats.parquet_open(plain_metadata())
  assert_eq(file.info().geometry, "geometry")
  let ranges = file.plan()
  assert_eq(ranges.length(), 3)
  // Each chunk as a part of its own, placed anywhere in the host's input.
  let parts = ranges.map(r => {
    (r.0, 0, parquet_plain[r.0.to_int():(r.0 + r.1).to_int()])
  })
  let t = file.read(parts)
  assert_eq(t.length(), 3)
  assert_eq(t.coords, [1.0, 2.0, 3.0, 4.0])
  assert_eq(file.packed_pages(parts), [])
  // A part that is missing is said so.
  let message = try file.read(parts[1:]) catch {
    e => e.message()
  } noraise {
    _ => ""
  }
  assert_true(
    message.contains("a column chunk outside the bytes read of the file"),
  )
}

///|
test "plan keeps the columns asked for and the rows whose geometry meets the box" {
  let file = @formats.parquet_open(plain_metadata())
  let whole = [(0L, 0, parquet_plain[:])]
  assert_eq(file.plan(columns=["n"]).length(), 2)
  let t = file.read(whole)
  assert_eq(t.columns.map(c => c.name), ["n"])
  assert_eq(t.length(), 3)
  assert_eq(file.plan(columns=[]).length(), 1)
  assert_eq(file.read(whole).columns.length(), 0)
  // Points (1, 2) and (3, 4), and a row without geometry, which no box keeps.
  file.plan(bbox=(2.5, 0.0, 9.0, 9.0)) |> ignore
  let t = file.read(whole)
  assert_eq(t.coords, [3.0, 4.0])
  assert_eq(t.column("n").unwrap().values, [Some(Num(2.0))])
  file.plan(bbox=(1.0, 2.0, 1.0, 2.0), columns=["name"]) |> ignore
  let t = file.read(whole)
  assert_eq(t.column("name").unwrap().values, [Some(Str("a"))])
  file.plan(bbox=(50.0, 50.0, 60.0, 60.0)) |> ignore
  assert_eq(file.read(whole).length(), 0)
  // Covering columns that the file lacks leave every row group to read.
  assert_eq(
    file
    .plan(bbox=(50.0, 50.0, 60.0, 60.0), covering=[
      "b.x0", "b.y0", "b.x1", "b.y1",
    ])
    .length(),
    3,
  )
  let refused = (columns : Array[String]) => {
    try file.plan(columns~) catch {
      e => e.message()
    } noraise {
      _ => ""
    }
  }
  assert_true(refused(["nope"]).contains("no column nope"))
  assert_true(refused(["geometry"]).contains("no column geometry"))
}

///|
test "parquet_open refuses a malformed footer" {
  let message = try @formats.parquet_open(b"\x15") catch {
    e => e.message()
  } noraise {
    _ => ""
  }
  assert_eq(message, "malformed Parquet at 0: a malformed footer")
}
