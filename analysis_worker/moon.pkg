// The analysis worker's wasm-gc module: GeoJSON read into datasets kept by
// handle, with their index built on first use. js/worker.mjs is its glue.

import {
  "t-ujiie-g/mbtmap_engine/analysis",
  "t-ujiie-g/mbtmap_engine/core",
  "t-ujiie-g/mbtmap_engine/formats",
  "t-ujiie-g/mbtmap_engine/geom",
  "t-ujiie-g/mbtmap_engine/raster",
  "t-ujiie-g/mbtmap_engine/wasmio",
}

supported_targets = "+wasm-gc"

pkgtype(kind: "foreign_library")

options(
  link: { "wasm-gc": { "export-memory-name": "memory" } },
)
