// JS-facing exports of the main thread; the npm TypeScript facade wraps these.

import {
  "t-ujiie-g/moonmap/core",
  "t-ujiie-g/moonmap/map",
  "t-ujiie-g/moonmap/render_webgl2",
  "t-ujiie-g/moonmap/web",
}

supported_targets = "js"

pkgtype(kind: "foreign_library")

options(
  link: { "js": { "format": "esm" } },
)
