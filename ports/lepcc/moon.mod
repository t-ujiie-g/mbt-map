// LEPCC in MoonBit: the blobs of I3S point cloud layers decoded as Esri's LEPCC C API does.

name = "t-ujiie-g/lepcc"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/t-ujiie-g/mbt-map"

license = "Apache-2.0"

keywords = [ "lepcc", "i3s", "point-cloud", "decoder" ]

description = "Esri's LEPCC decoders (I3S point clouds: lepcc-xyz, lepcc-rgb, lepcc-intensity) in MoonBit"
