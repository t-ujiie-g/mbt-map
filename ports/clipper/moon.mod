// Clipper2 in MoonBit: polygon clipping and offsetting on 64-bit integers.

name = "t-ujiie-g/clipper"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/t-ujiie-g/mbt-map"

license = "Apache-2.0 AND BSL-1.0"

keywords = [ "clipper2", "polygon", "clipping", "offset", "geometry" ]

description = "A port of Clipper2: polygon union, intersection, difference, xor and offsetting, with results identical to the C++ library"
